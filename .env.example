# ============================================================
# HealthTriage AI - Environment Template (.env.example)
# Copy this file to .env and configure with your environment values
# ============================================================

# Gemini AI API Configuration
# Get your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=healthtriage

# JWT Authentication & Security Configuration
# Generate a strong 32+ character secret string for production
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30

# Server Configuration
HOST=127.0.0.1
PORT=8000

# SMTP Email Configuration (Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
